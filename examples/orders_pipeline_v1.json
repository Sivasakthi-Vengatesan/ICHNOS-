{
  "pipeline_name": "orders_pipeline",
  "version": "v1",
  "description": "Clean baseline verified orders processing pipeline.",
  "schema": {
    "id": "int",
    "amount": "float",
    "status": "string",
    "region": "string"
  },
  "transformation_ir": [
    {
      "op": "FILTER",
      "column": "status",
      "operator": "==",
      "value": "PAID",
      "expression": "status == 'PAID'",
      "node_name": "clean_orders"
    },
    {
      "op": "AGGREGATE_SUM",
      "column": "amount",
      "node_name": "revenue_daily"
    }
  ],
  "invariant": "ASSERT output.total_amount == input.total_amount - refunded.total_amount"
}
